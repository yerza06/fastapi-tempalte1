# Скопируйте в .env и заполните: cp .env.example .env
# Вложенные настройки задаются через "__": <секция>__<поле>

# Настройки uvicorn
RUN__HOST=localhost
RUN__PORT=8000
RUN__RELOAD=false

# Настройки приложения
APP__TITLE="Template 1"
APP__SUMMARY="Это шаблон для FastAPI"
APP__DESCRIPTION="Описании"
APP__DEBUG=False
APP__VERSION=0.1.0
# local | ci | production | prod
APP__ENVIRONMENT=local
# DEBUG | INFO | WARNING | ERROR | CRITICAL
APP__LOGLEVEL=INFO


# Настройки базы данных
DB__HOST=localhost
DB__PORT=5432
DB__USERNAME=postgres
DB__PASSWORD=postgres
DB__DATABASE=learn1
DB__DRIVER=postgresql+asyncpg

# Настройки JWT
# Сгенерировать ключ: python -c "import secrets; print(secrets.token_urlsafe(64)) | openssl rand -hex 32"
JWT__SECRET_KEY=change-me
JWT__ALGORITHM=HS256
JWT__ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT__REFRESH_TOKEN_EXPIRES_DAYS=7
